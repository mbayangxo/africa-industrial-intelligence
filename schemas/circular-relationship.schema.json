{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://africa-industrial-intelligence.local/schemas/circular-relationship.schema.json",
  "type":"object", "additionalProperties":false, "required":["schema_version","id","from_node","to_node","relationship","classification","source_ids","status"],
  "properties":{"schema_version":{"const":"1.0.0"},"id":{"type":"string","pattern":"^rel-[a-z0-9-]+$"},"from_node":{"$ref":"#/$defs/node"},"to_node":{"$ref":"#/$defs/node"},"relationship":{"enum":["produces","uses-input","could-use","substitutes-import","shares-infrastructure","processes-into","waste-to-value"]},"material":{"type":"string"},"quantity":{"type":"object","properties":{"value":{"type":"number"},"unit":{"type":"string"},"period":{"type":"string"}},"required":["value","unit"],"additionalProperties":false},"classification":{"enum":["FACT","ESTIMATE","ASSUMPTION","SCENARIO","HYPOTHESIS"]},"source_ids":{"type":"array","items":{"type":"string","pattern":"^src-"}},"constraints":{"type":"array","items":{"type":"string"}},"status":{"enum":["candidate","validated","rejected"]}},
