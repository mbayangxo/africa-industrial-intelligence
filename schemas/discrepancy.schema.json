{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://africa-industrial-intelligence.local/schemas/discrepancy.schema.json",
  "type":"object", "additionalProperties":false, "required":["schema_version","id","claim_ids","description","status","created_at"],
